# MongoDB connection string. Use a dedicated local or deployment-specific user.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/criczone?retryWrites=true&w=majority

# Random secret used to sign access tokens (generate at least 32 random bytes).
JWT_SECRET=replace-with-a-long-random-secret

# Access-token lifetime accepted by jsonwebtoken, for example 30m or 1h.
JWT_ACCESS_EXPIRE=30m

# Refresh-session lifetime in days (clamped to 1-30 days).
JWT_REFRESH_EXPIRE_DAYS=14

# HTTP port used by the Express server.
PORT=5000

# Runtime mode: development, test, or production.
NODE_ENV=development

# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:3000

# Set to true only for intentionally public development environments.
ALLOW_ALL_ORIGINS=false
