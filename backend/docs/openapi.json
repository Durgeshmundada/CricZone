{
  "openapi": "3.0.3",
  "info": {
    "title": "CricZone API",
    "version": "1.0.0",
    "description": "Core authentication and cricket match endpoints. Additional controller coverage is tracked as a documentation follow-up.",
    "license": { "name": "ISC", "url": "https://opensource.org/license/isc-license-txt/" }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current CricZone deployment"
    }
  ],
  "tags": [
    { "name": "Authentication", "description": "Registration and access/refresh session lifecycle." },
    { "name": "Matches", "description": "Match scheduling, scoring, completion, highlights, and reports." }
  ],
  "security": [],
  "paths": {
    "/api/users/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a user and create a session",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and create a session",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "423": {
            "description": "Account temporarily locked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/users/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Rotate a refresh session and issue a new access token",
        "operationId": "refreshSession",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session refreshed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/users/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke the current refresh session",
        "operationId": "logoutUser",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/matches": {
      "get": {
        "tags": ["Matches"],
        "summary": "List matches",
        "operationId": "getAllMatches",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Paginated matches",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Matches"],
        "summary": "Create a match",
        "operationId": "createMatch",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMatchInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Match created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/matches/live": {
      "get": {
        "tags": ["Matches"],
        "summary": "List live matches",
        "operationId": "getLiveMatches",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Paginated live matches",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/matches/user/my-matches": {
      "get": {
        "tags": ["Matches"],
        "summary": "List matches associated with the current user",
        "operationId": "getUserMatches",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Current user's matches",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/matches/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
      "get": {
        "tags": ["Matches"],
        "summary": "Get one match",
        "operationId": "getMatch",
        "responses": {
          "200": {
            "description": "Match details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Matches"],
        "summary": "Delete a match owned by the current user",
        "operationId": "deleteMatch",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/SuccessMessage" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/matches/{id}/toss": {
      "put": {
        "tags": ["Matches"],
        "summary": "Set the toss and start a match",
        "operationId": "setMatchToss",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TossInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Toss set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/matches/{id}/score": {
      "put": {
        "tags": ["Matches"],
        "summary": "Record a ball or update the score",
        "operationId": "updateMatchScore",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ScoreUpdateInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SuccessMessage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/matches/{id}/complete": {
      "put": {
        "tags": ["Matches"],
        "summary": "Complete a match",
        "operationId": "completeMatch",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
        "responses": {
          "200": {
            "description": "Match completed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/matches/{id}/highlights": {
      "get": {
        "tags": ["Matches"],
        "summary": "Get detected match highlights",
        "operationId": "getMatchHighlights",
        "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
        "responses": {
          "200": {
            "description": "Match highlights",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "count", "highlights"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "count": { "type": "integer" },
                    "highlights": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/matches/{id}/report": {
      "get": {
        "tags": ["Matches"],
        "summary": "Get a match report as JSON or CSV",
        "operationId": "getMatchReport",
        "parameters": [
          { "$ref": "#/components/parameters/MatchId" },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["json", "csv"], "default": "json" }
          }
        ],
        "responses": {
          "200": {
            "description": "Match report",
            "content": {
              "application/json": { "schema": { "type": "object", "additionalProperties": true } },
              "text/csv": { "schema": { "type": "string" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "MatchId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Authenticated user is not authorized",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "SuccessMessage": {
        "description": "Operation completed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      },
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "phone", "password"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "phone": { "type": "string", "maxLength": 20 },
          "password": { "type": "string", "format": "password", "minLength": 6, "maxLength": 128 }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "additionalProperties": false,
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "format": "password", "minLength": 1, "maxLength": 128 }
        }
      },
      "RefreshTokenInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refreshToken": { "type": "string", "minLength": 32, "maxLength": 256 }
        },
        "description": "The refresh token may alternatively be supplied by the HttpOnly refreshToken cookie."
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "role": { "type": "string" }
        },
        "additionalProperties": true
      },
      "AuthResponse": {
        "type": "object",
        "required": ["success", "token", "expiresIn", "user"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "token": { "type": "string" },
          "expiresIn": { "type": "string", "example": "30m" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "additionalProperties": true
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["success", "token", "expiresIn"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "token": { "type": "string" },
          "expiresIn": { "type": "string", "example": "30m" }
        }
      },
      "PlayerInput": {
        "oneOf": [
          { "type": "string", "maxLength": 100 },
          {
            "type": "object",
            "properties": {
              "name": { "type": "string", "maxLength": 100 },
              "email": { "type": "string", "format": "email" },
              "userId": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      },
      "CreateMatchInput": {
        "type": "object",
        "required": ["matchName", "venue", "matchDate"],
        "properties": {
          "matchName": { "type": "string", "maxLength": 120 },
          "matchType": { "type": "string", "enum": ["T20", "ODI", "Test", "Custom"], "default": "T20" },
          "customOvers": { "type": "integer", "minimum": 1, "maximum": 50 },
          "teamAName": { "type": "string", "maxLength": 80 },
          "teamAId": { "type": "string" },
          "teamAPlayers": { "type": "array", "maxItems": 30, "items": { "$ref": "#/components/schemas/PlayerInput" } },
          "teamBName": { "type": "string", "maxLength": 80 },
          "teamBId": { "type": "string" },
          "teamBPlayers": { "type": "array", "maxItems": 30, "items": { "$ref": "#/components/schemas/PlayerInput" } },
          "venue": { "type": "string", "maxLength": 200 },
          "matchDate": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "format": "date-time" }
            ]
          },
          "tournamentId": { "type": "string" }
        },
        "description": "Each team requires either its name or a saved team ID. Custom matches also require customOvers.",
        "additionalProperties": true
      },
      "TossInput": {
        "type": "object",
        "properties": {
          "tossWinnerTeam": { "type": "string", "maxLength": 100 },
          "tossWinner": { "type": "string", "maxLength": 100, "deprecated": true },
          "decision": { "type": "string", "enum": ["bat", "bowl"] },
          "tossDecision": { "type": "string", "enum": ["bat", "bowl"], "deprecated": true }
        },
        "description": "Provide tossWinnerTeam or tossWinner, plus decision or tossDecision.",
        "additionalProperties": true
      },
      "ScoreUpdateInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "runs": { "type": "number" },
          "wickets": { "type": "number" },
          "isWicket": { "type": "boolean" },
          "extras": { "type": "object", "additionalProperties": true },
          "batsmanName": { "type": "string", "maxLength": 100 },
          "batsmanId": { "type": "string" },
          "nonStrikerName": { "type": "string", "maxLength": 100 },
          "nonStrikerId": { "type": "string" },
          "bowlerName": { "type": "string", "maxLength": 100 },
          "bowlerId": { "type": "string" },
          "overs": { "type": "number" },
          "mode": { "type": "string", "enum": ["absolute", "ball"] },
          "status": { "type": "string", "enum": ["live"] }
        },
        "additionalProperties": true
      },
      "Match": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "matchName": { "type": "string" },
          "matchType": { "type": "string" },
          "venue": { "type": "string" },
          "matchDate": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["scheduled", "live", "completed", "cancelled"] },
          "teamA": { "type": "object", "additionalProperties": true },
          "teamB": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      },
      "MatchResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Match" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "hasNextPage": { "type": "boolean" },
          "hasPreviousPage": { "type": "boolean" }
        }
      },
      "MatchListResponse": {
        "type": "object",
        "required": ["success", "count", "data", "meta"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "count": { "type": "integer" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Match" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      }
    }
  }
}
